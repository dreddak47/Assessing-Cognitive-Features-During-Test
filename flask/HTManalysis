# Extract FAU list
def extract_faus(data_str):
    try:
        faus = eval(data_str.split('=')[-1])
        return [reverse_map[fa] for fa in faus if fa in reverse_map]
    except:
        return []

def parse_variable_fields(field_str):
  try:
    return json.loads(field_str)
  except json.JSONDecodeError:
    return {}

def list_to_vector(fau_list):
    vec = [0] * 12
    for i in fau_list:
        if 0 <= i < 12:
            vec[i] += 1
    return vec

