## 1st Analysis
# Merge half-second bins into 1-second bins: group every 2
def to_1s_bins(window):
    return [np.mean(window[i:i+2]) for i in range(0, 12, 2)]  # Only 6 full 1s bins from 12 values

binned_data = guess_event_df['windowData'].apply(to_1s_bins)
binned_array = np.stack(binned_data)

# Calculate the mean anomaly score per 1-second bin
mean_scores = binned_array.mean(axis=0)

# Label for 1s bins
time_bins = ['-3s to -2s', '-2s to -1s', '-1s to 0s', '0s to +1s', '+1s to +2s', '+2s to +3s']
for label, score in zip(time_bins, mean_scores):
    print(f"{label}: {score:.3f}")


## 2nd Analysis
# Subset 180 guesses made under pressure (last 200s of the test)
LAST_LEFT = 200  

# Guess under pressure
guess_under_pressure = guess_event_df[
    (guess_event_df['type'].notnull()) & 
    (guess_event_df['timeElapsed'] >= LAST_LEFT - 10)
].sample(n=180, random_state=42)

